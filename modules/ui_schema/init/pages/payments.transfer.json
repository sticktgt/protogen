{
  "id": "payments.transfer",
  "title": "Перевод между своими счетами",
  "description": "Экран перевода средств между счетами клиента",
  "elements": [
    {
      "id": "payments.transfer.steps",
      "type": "wizard",
      "label": "Шаги перевода",
      "children": [
        {
          "id": "payments.transfer.step.params",
          "type": "section",
          "label": "Параметры перевода",
          "children": [
            {
              "id": "payments.transfer.form",
              "type": "form",
              "label": "Форма перевода",
              "purpose": "Ввод параметров перевода",
              "children": [
                {
                  "id": "payments.transfer.from_account",
                  "type": "select",
                  "label": "Счет списания"
                },
                {
                  "id": "payments.transfer.to_account",
                  "type": "select",
                  "label": "Счет зачисления"
                },
                {
                  "id": "payments.transfer.amount",
                  "type": "input",
                  "label": "Сумма"
                },
                {
                  "id": "payments.transfer.comment",
                  "type": "textarea",
                  "label": "Комментарий"
                },
                {
                  "id": "payments.transfer.date",
                  "type": "date_picker",
                  "label": "Дата исполнения"
                }
              ]
            }
          ]
        },
        {
          "id": "payments.transfer.step.confirm",
          "type": "section",
          "label": "Подтверждение",
          "children": [
            {
              "id": "payments.transfer.confirm_summary",
              "type": "details_panel",
              "label": "Сводка перевода"
            },
            {
              "id": "payments.transfer.submit",
              "type": "button",
              "label": "Перевести",
              "actions": [
                {
                  "type": "call_api",
                  "api_ref": "payments.create_transfer"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "payments.transfer.side_panel",
      "type": "details_panel",
      "label": "Подсказки и быстрые ссылки",
      "children": [
        {
          "id": "payments.transfer.limit_info",
          "type": "text",
          "label": "Лимиты по переводам"
        },
        {
          "id": "payments.transfer.template_link",
          "type": "link",
          "label": "Использовать шаблон платежа"
        },
        {
          "id": "payments.transfer.history_link",
          "type": "link",
          "label": "История переводов"
        }
      ]
    }
  ]
}
