{
  "id": "transfer",
  "title": "Перевод между счетами",
  "description": "Перевод средств между своими счетами клиента",
  "fields": [
    {
      "id": "id",
      "title": "Идентификатор перевода",
      "type": "uuid",
      "required": true,
      "description": "Логический идентификатор перевода"
    },
    {
      "id": "customer_id",
      "title": "Клиент",
      "type": "uuid",
      "required": true,
      "description": "Клиент, создающий перевод"
    },
    {
      "id": "from_account_id",
      "title": "Счет списания",
      "type": "uuid",
      "required": true,
      "description": "Счет, с которого списываются средства"
    },
    {
      "id": "to_account_id",
      "title": "Счет зачисления",
      "type": "uuid",
      "required": true,
      "description": "Счет, на который зачисляются средства"
    },
    {
      "id": "amount",
      "title": "Сумма",
      "type": "decimal",
      "required": true,
      "description": "Сумма перевода"
    },
    {
      "id": "execution_date",
      "title": "Дата исполнения",
      "type": "date",
      "required": false,
      "description": "Плановая дата исполнения перевода"
    },
    {
      "id": "status",
      "title": "Статус",
      "type": "dictionary",
      "dictionary_id": "operation_status",
      "required": true,
      "description": "Статус перевода"
    },
    {
      "id": "currency",
      "title": "Валюта",
      "type": "dictionary",
      "required": true,
      "description": "Валюта перевода",
      "dictionary_id": "currency"
    },
    {
      "id": "comment",
      "title": "Комментарий",
      "type": "text",
      "required": false,
      "description": "Комментарий к переводу"
    },
    {
      "id": "created_date",
      "title": "Дата создания",
      "type": "datetime",
      "required": false,
      "description": "Дата создания перевода"
    }
  ]
}