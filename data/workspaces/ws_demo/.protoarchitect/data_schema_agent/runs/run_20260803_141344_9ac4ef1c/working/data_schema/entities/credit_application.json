{
  "id": "credit_application",
  "title": "Заявка на кредит",
  "description": "Заявка клиента на получение кредита.",
  "fields": [
    {
      "id": "id",
      "title": "Идентификатор заявки",
      "type": "uuid",
      "required": true,
      "description": "Логический идентификатор заявки."
    },
    {
      "id": "customer_id",
      "title": "Клиент",
      "type": "uuid",
      "required": true,
      "description": "Клиент, подающий заявку."
    },
    {
      "id": "product_type",
      "title": "Тип кредита",
      "type": "dictionary",
      "dictionary_id": "credit_product_type",
      "required": true,
      "description": "Выбранный тип кредита."
    },
    {
      "id": "requested_amount",
      "title": "Запрошенная сумма",
      "type": "decimal",
      "required": true,
      "description": "Сумма кредита."
    },
    {
      "id": "term_months",
      "title": "Срок",
      "type": "integer",
      "required": true,
      "description": "Срок кредита в месяцах."
    },
    {
      "id": "monthly_income",
      "title": "Ежемесячный доход",
      "type": "decimal",
      "required": true,
      "description": "Доход клиента для оценки заявки."
    },
    {
      "id": "status",
      "title": "Статус заявки",
      "type": "dictionary",
      "dictionary_id": "application_status",
      "required": true,
      "description": "Состояние заявки."
    },
    {
      "id": "currency",
      "title": "Валюта",
      "type": "dictionary",
      "required": true,
      "description": "Валюта кредита.",
      "dictionary_id": "currency"
    },
    {
      "id": "has_insurance",
      "title": "Страхование",
      "type": "boolean",
      "required": false,
      "description": "Признак страхования кредита."
    },
    {
      "id": "phone",
      "title": "Телефон",
      "type": "string",
      "required": true,
      "description": "Контактный телефон для заявки."
    },
    {
      "id": "email",
      "title": "Email",
      "type": "string",
      "required": false,
      "description": "Email для заявки."
    },
    {
      "id": "comment",
      "title": "Комментарий",
      "type": "text",
      "required": false,
      "description": "Комментарий к заявке."
    },
    {
      "id": "created_date",
      "title": "Дата создания",
      "type": "datetime",
      "required": true,
      "description": "Дата создания заявки."
    },
    {
      "id": "preliminary_decision",
      "title": "Предварительное решение",
      "type": "text",
      "required": false,
      "description": "Предварительное решение по заявке."
    }
  ]
}