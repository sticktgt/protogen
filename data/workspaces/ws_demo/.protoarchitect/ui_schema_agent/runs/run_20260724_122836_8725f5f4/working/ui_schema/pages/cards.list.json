{
  "id": "cards.list",
  "title": "Список карт",
  "description": "Страница просмотра карт клиента с основными атрибутами и действиями",
  "elements": [
    {
      "id": "cards.list.toolbar",
      "type": "toolbar",
      "label": "Панель действий",
      "children": [
        {
          "id": "cards.list.refresh",
          "type": "button",
          "label": "Обновить"
        }
      ]
    },
    {
      "id": "cards.list.filters",
      "type": "filter_panel",
      "label": "Фильтры карт",
      "children": [
        {
          "id": "cards.list.filter.status",
          "type": "select",
          "label": "Статус"
        },
        {
          "id": "cards.list.filter.type",
          "type": "select",
          "label": "Тип карты"
        }
      ]
    },
    {
      "id": "cards.list.table",
      "type": "table_with_actions",
      "label": "Таблица карт",
      "description": "Отображает маскированный номер, платежную систему, тип, статус, срок действия и связанный счет",
      "children": [
        {
          "id": "cards.list.table.column.number",
          "type": "text",
          "label": "Маскированный номер"
        },
        {
          "id": "cards.list.table.column.payment_system",
          "type": "text",
          "label": "Платежная система"
        },
        {
          "id": "cards.list.table.column.type",
          "type": "text",
          "label": "Тип карты"
        },
        {
          "id": "cards.list.table.column.status",
          "type": "text",
          "label": "Статус"
        },
        {
          "id": "cards.list.table.column.expiry",
          "type": "text",
          "label": "Срок действия"
        },
        {
          "id": "cards.list.table.column.account",
          "type": "text",
          "label": "Счет"
        },
        {
          "id": "cards.list.table.action.block",
          "type": "button",
          "label": "Заблокировать",
          "actions": [
            {
              "type": "navigate",
              "target_page": "cards.block"
            }
          ]
        }
      ]
    }
  ]
}
