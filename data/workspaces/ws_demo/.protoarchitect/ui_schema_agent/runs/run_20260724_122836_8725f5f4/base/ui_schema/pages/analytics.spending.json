{
  "id": "analytics.spending",
  "title": "Аналитика трат",
  "description": "Дашборд трат клиента за выбранный период",
  "elements": [
    {
      "id": "analytics.spending.filters",
      "type": "filter_panel",
      "label": "Параметры периода",
      "children": [
        {
          "id": "analytics.spending.period_from",
          "type": "date_picker",
          "label": "Дата с"
        },
        {
          "id": "analytics.spending.period_to",
          "type": "date_picker",
          "label": "Дата по"
        },
        {
          "id": "analytics.spending.account",
          "type": "select",
          "label": "Счет или карта"
        },
        {
          "id": "analytics.spending.apply",
          "type": "button",
          "label": "Показать"
        }
      ]
    },
    {
      "id": "analytics.spending.summary",
      "type": "grid",
      "label": "Сводные показатели",
      "children": [
        {
          "id": "analytics.spending.total",
          "type": "card",
          "label": "Общие траты"
        },
        {
          "id": "analytics.spending.average",
          "type": "card",
          "label": "Средний платеж"
        },
        {
          "id": "analytics.spending.top_category",
          "type": "card",
          "label": "Крупнейшая категория"
        }
      ]
    },
    {
      "id": "analytics.spending.charts",
      "type": "tabs",
      "label": "Разделы аналитики",
      "children": [
        {
          "id": "analytics.spending.by_category",
          "type": "section",
          "label": "По категориям",
          "children": [
            {
              "id": "analytics.spending.category_cards",
              "type": "grid",
              "label": "Карточки категорий"
            },
            {
              "id": "analytics.spending.category_table",
              "type": "table",
              "label": "Таблица категорий"
            }
          ]
        },
        {
          "id": "analytics.spending.by_period",
          "type": "section",
          "label": "По периодам",
          "children": [
            {
              "id": "analytics.spending.period_list",
              "type": "list",
              "label": "Динамика расходов"
            },
            {
              "id": "analytics.spending.period_table",
              "type": "table",
              "label": "Расходы по дням"
            }
          ]
        }
      ]
    },
    {
      "id": "analytics.spending.actions",
      "type": "toolbar",
      "label": "Действия",
      "children": [
        {
          "id": "analytics.spending.export",
          "type": "button",
          "label": "Экспортировать отчет"
        },
        {
          "id": "analytics.spending.statement",
          "type": "button",
          "label": "Сформировать выписку"
        }
      ]
    }
  ]
}
