{
  "id": "home",
  "title": "Главная",
  "description": "Стартовый экран банковского фронт-офиса клиента",
  "elements": [
    {
      "id": "home.header",
      "type": "section",
      "label": "Шапка главной страницы",
      "children": [
        {
          "id": "home.header.greeting",
          "type": "text",
          "label": "Приветствие клиента"
        },
        {
          "id": "home.header.notifications",
          "type": "button",
          "label": "Уведомления"
        },
        {
          "id": "home.header.profile",
          "type": "button",
          "label": "Профиль"
        }
      ]
    },
    {
      "id": "home.summary_grid",
      "type": "grid",
      "label": "Сводка по продуктам",
      "children": [
        {
          "id": "home.summary.accounts",
          "type": "card",
          "label": "Счета и баланс"
        },
        {
          "id": "home.summary.cards",
          "type": "card",
          "label": "Карты"
        },
        {
          "id": "home.summary.deposits",
          "type": "card",
          "label": "Вклады"
        },
        {
          "id": "home.summary.credits",
          "type": "card",
          "label": "Кредиты"
        }
      ]
    },
    {
      "id": "home.quick_actions",
      "type": "section",
      "label": "Быстрые действия",
      "children": [
        {
          "id": "home.quick.transfer",
          "type": "button",
          "label": "Перевести между счетами",
          "actions": [
            {
              "target_page": "payments.transfer",
              "type": "navigate"
            }
          ]
        },
        {
          "id": "home.quick.deposit",
          "type": "button",
          "label": "Открыть депозит",
          "actions": [
            {
              "target_page": "deposits.open",
              "type": "navigate"
            }
          ]
        },
        {
          "id": "home.quick.credit",
          "type": "button",
          "label": "Подать заявку на кредит",
          "actions": [
            {
              "target_page": "credits.apply",
              "type": "navigate"
            }
          ]
        },
        {
          "actions": [
            {
              "target_page": "cards.block",
              "type": "navigate"
            }
          ],
          "id": "home.quick.block_card",
          "label": "Заблокировать карту",
          "type": "button"
        }
      ]
    },
    {
      "id": "home.recent_transactions",
      "label": "Последние операции",
      "type": "section",
      "children": [
        {
          "description": "Последние операции клиента",
          "id": "home.recent_transactions.table",
          "label": "Список операций",
          "type": "table_with_actions",
          "children": [
            {
              "id": "home.recent_transactions.table.column.date",
              "label": "Дата",
              "type": "table_column"
            },
            {
              "id": "home.recent_transactions.table.column.description",
              "label": "Описание",
              "type": "table_column"
            },
            {
              "id": "home.recent_transactions.table.column.amount",
              "label": "Сумма",
              "type": "table_column"
            },
            {
              "id": "home.recent_transactions.table.column.currency",
              "label": "Валюта",
              "type": "table_column"
            },
            {
              "id": "home.recent_transactions.table.column.direction",
              "label": "Направление",
              "type": "table_column"
            }
          ]
        }
      ]
    },
    {
      "id": "home.alerts",
      "type": "list",
      "label": "Важные уведомления",
      "children": [
        {
          "id": "home.alerts.security",
          "type": "badge",
          "label": "Проверьте настройки безопасности"
        },
        {
          "id": "home.alerts.statement",
          "type": "badge",
          "label": "Доступна новая выписка"
        }
      ]
    }
  ]
}