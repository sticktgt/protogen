{
  "description": "Формирование выписки по выбранному счету за период",
  "id": "reports.statement",
  "title": "Выписка по счету",
  "elements": [
    {
      "id": "reports.statement.form",
      "label": "Фильтры выписки",
      "type": "form",
      "children": [
        {
          "id": "reports.statement.account_select",
          "label": "Счет",
          "type": "select"
        },
        {
          "id": "reports.statement.date_from",
          "label": "Дата начала",
          "type": "date_picker"
        },
        {
          "id": "reports.statement.date_to",
          "label": "Дата окончания",
          "type": "date_picker"
        },
        {
          "id": "reports.statement.generate",
          "label": "Сформировать выписку",
          "type": "button"
        }
      ]
    },
    {
      "id": "reports.statement.results",
      "label": "Результаты выписки",
      "type": "section",
      "children": [
        {
          "id": "reports.statement.summary",
          "label": "Итоги выписки",
          "type": "grid",
          "children": [
            {
              "id": "reports.statement.opening_balance",
              "label": "Начальный остаток",
              "type": "card"
            },
            {
              "id": "reports.statement.closing_balance",
              "label": "Конечный остаток",
              "type": "card"
            },
            {
              "id": "reports.statement.total_credits",
              "label": "Сумма поступлений",
              "type": "card"
            },
            {
              "id": "reports.statement.total_debits",
              "label": "Сумма списаний",
              "type": "card"
            }
          ]
        },
        {
          "description": "Таблица операций за выбранный период",
          "id": "reports.statement.transactions_table",
          "label": "Операции",
          "type": "table_with_actions",
          "children": [
            {
              "id": "reports.statement.transactions_table.column.date",
              "label": "Дата",
              "type": "table_column"
            },
            {
              "id": "reports.statement.transactions_table.column.description",
              "label": "Описание",
              "type": "table_column"
            },
            {
              "id": "reports.statement.transactions_table.column.category",
              "label": "Категория",
              "type": "table_column"
            },
            {
              "id": "reports.statement.transactions_table.column.direction",
              "label": "Направление",
              "type": "table_column"
            },
            {
              "id": "reports.statement.transactions_table.column.amount",
              "label": "Сумма",
              "type": "table_column"
            },
            {
              "id": "reports.statement.transactions_table.column.currency",
              "label": "Валюта",
              "type": "table_column"
            },
            {
              "id": "reports.statement.transactions_table.column.status",
              "label": "Статус",
              "type": "table_column"
            }
          ]
        }
      ]
    }
