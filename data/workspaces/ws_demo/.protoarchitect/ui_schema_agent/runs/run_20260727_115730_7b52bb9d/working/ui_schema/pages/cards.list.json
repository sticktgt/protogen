{
  "description": "Экран просмотра банковских карт клиента",
  "id": "cards.list",
  "title": "Список карт",
  "elements": [
    {
      "id": "cards.list.toolbar",
      "label": "Панель действий",
      "type": "toolbar",
      "children": [
        {
          "id": "cards.list.refresh",
          "label": "Обновить",
          "type": "button"
        }
      ]
    },
    {
      "id": "cards.list.content",
      "label": "Область карт",
      "type": "grid",
      "children": [
        {
          "description": "Отображает карты клиента с основными атрибутами",
          "id": "cards.list.table",
          "label": "Таблица карт",
          "type": "table_with_actions",
          "children": [
            {
              "id": "cards.list.table.column.masked_number",
              "label": "Номер карты",
              "type": "table_column"
            },
            {
              "id": "cards.list.table.column.payment_system",
              "label": "Платежная система",
              "type": "table_column"
            },
            {
              "id": "cards.list.table.column.type",
              "label": "Тип",
              "type": "table_column"
            },
            {
              "id": "cards.list.table.column.status",
              "label": "Статус",
              "type": "table_column"
            },
            {
              "id": "cards.list.table.column.account",
              "label": "Счет",
              "type": "table_column"
            },
            {
              "id": "cards.list.table.action.block",
              "label": "Заблокировать",
              "type": "button"
            }
          ]
        }
      ]
    },
    {
      "id": "cards.list.details_panel",
      "label": "Детали карты",
      "type": "details_panel",
      "children": [
        {
          "id": "cards.list.details.masked_number",
          "label": "Номер карты",
          "type": "text"
        },
        {
          "id": "cards.list.details.payment_system",
          "label": "Платежная система",
          "type": "text"
        },
        {
          "id": "cards.list.details.type",
          "label": "Тип",
          "type": "text"
        },
        {
          "id": "cards.list.details.status",
          "label": "Статус",
          "type": "text"
        },
        {
          "id": "cards.list.details.account",
          "label": "Счет",
          "type": "text"
        },
        {
          "id": "cards.list.details.expiry",
          "label": "Срок действия",
          "type": "text"
        },
        {
          "actions": [
            {
              "target_page": "cards.block",
              "type": "navigate"
            }
          ],
          "id": "cards.list.block_action",
          "label": "Заблокировать карту",
          "type": "button"
        }
      ]
    }
  ]
}