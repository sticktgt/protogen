{
  "id": "analytics.spending",
  "title": "Аналитика трат",
  "description": "Дашборд трат клиента за выбранный период",
  "elements": [
    {
      "id": "analytics.spending.filters",
      "type": "filter_panel",
      "label": "Параметры периода",
      "children": [
        {
          "id": "analytics.spending.period_from",
          "type": "date_picker",
          "label": "Дата с"
        },
        {
          "id": "analytics.spending.period_to",
          "type": "date_picker",
          "label": "Дата по"
        },
        {
          "id": "analytics.spending.account",
          "type": "select",
          "label": "Счет или карта"
        },
        {
          "id": "analytics.spending.apply",
          "type": "button",
          "label": "Показать"
        }
      ]
    },
    {
      "id": "analytics.spending.summary",
      "type": "grid",
      "label": "Сводные показатели",
      "children": [
        {
          "id": "analytics.spending.total",
          "type": "card",
          "label": "Общие траты"
        },
        {
          "id": "analytics.spending.average",
          "type": "card",
          "label": "Средний платеж"
        },
        {
          "id": "analytics.spending.top_category",
          "type": "card",
          "label": "Крупнейшая категория"
        }
      ]
    },
    {
      "id": "analytics.spending.charts",
      "type": "tabs",
      "label": "Разделы аналитики",
      "children": [
        {
          "id": "analytics.spending.by_category",
          "type": "section",
          "label": "По категориям",
          "children": [
            {
              "id": "analytics.spending.category_cards",
              "type": "grid",
              "label": "Карточки категорий"
            },
            {
              "id": "analytics.spending.category_table",
              "type": "table",
              "label": "Таблица категорий"
            },
            {
              "id": "analytics.spending.category_cards.card",
              "type": "card",
              "label": "Карточка категории",
              "children": [
                {
                  "id": "analytics.spending.category_cards.card.name",
                  "type": "text",
                  "label": "Название категории"
                },
                {
                  "id": "analytics.spending.category_cards.card.amount",
                  "type": "text",
                  "label": "Сумма расходов"
                },
                {
                  "id": "analytics.spending.category_cards.card.share",
                  "type": "text",
                  "label": "Доля расходов"
                },
                {
                  "id": "analytics.spending.category_cards.card.count",
                  "type": "text",
                  "label": "Количество операций"
                }
              ]
            },
            {
              "id": "analytics.spending.category_table.operations",
              "type": "table",
              "label": "Операции категории",
              "children": [
                {
                  "id": "analytics.spending.category_table.operations.date",
                  "type": "table_column",
                  "label": "Дата"
                },
                {
                  "id": "analytics.spending.category_table.operations.amount",
                  "type": "table_column",
                  "label": "Сумма"
                },
                {
                  "id": "analytics.spending.category_table.operations.description",
                  "type": "table_column",
                  "label": "Описание"
                }
              ]
            }
          ]
        },
        {
          "id": "analytics.spending.by_period",
          "type": "section",
          "label": "По периодам",
          "children": [
            {
              "id": "analytics.spending.period_list",
              "type": "list",
              "label": "Динамика расходов"
            },
            {
              "id": "analytics.spending.period_table",
              "type": "table",
              "label": "Расходы по дням"
            }
          ]
        }
      ]
    },
    {
      "id": "analytics.spending.actions",
      "type": "toolbar",
      "label": "Действия",
      "children": [
        {
          "id": "analytics.spending.export",
          "type": "button",
          "label": "Экспортировать отчет"
        },
        {
          "id": "analytics.spending.statement",
          "type": "button",
          "label": "Сформировать выписку"
        }
      ]
    },
    {
      "id": "analytics.spending.statement_panel",
      "type": "modal",
      "label": "Выписка по счету",
      "children": [
        {
          "id": "analytics.spending.statement_panel.start_balance",
          "type": "text",
          "label": "Начальный остаток"
        },
        {
          "id": "analytics.spending.statement_panel.end_balance",
          "type": "text",
          "label": "Конечный остаток"
        },
        {
          "id": "analytics.spending.statement_panel.income",
          "type": "text",
          "label": "Сумма поступлений"
        },
        {
          "id": "analytics.spending.statement_panel.expenses",
          "type": "text",
          "label": "Сумма списаний"
        }
      ]
    }
  ]
}